# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Set these with `wrangler secret put` before a real deploy.

# Comma-separated admin emails. Only these addresses can open /admin.
ADMIN_EMAILS="you@example.com"

# Random string, at least 32 characters. It signs the admin session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# Google OAuth web client. Redirect: https://<worker>/admin/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple Services ID. Redirect: https://<worker>/admin/oauth/apple/callback
APPLE_SERVICES_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Contents of the Sign in with Apple .p8, including the BEGIN/END lines, with newlines as \n.
APPLE_PRIVATE_KEY=""

# Local StoreKit configuration purchases are signed as environment "Xcode", not by Apple.
# true only on your computer. Leave false, or unset, on any deployed Worker.
ALLOW_XCODE_JWS="true"
